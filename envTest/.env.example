# Copier en .env. Tout ce que les trois clients ont besoin de savoir.

# Le proxy, VU DEPUIS LES CONTENEURS. Ils tournent en réseau hôte
# (network_mode: host) : 127.0.0.1:8000 est donc le proxy lancé par le
# docker-compose de la racine. Sur Docker Desktop (mac/Windows), le réseau
# hôte n'existe pas : mettre http://host.docker.internal:8000.
#
# Proxy DISTANT (déjà déployé) : son adresse, telle que la machine qui lance
# les conteneurs la joint — en réseau hôte, c'est elle qui résout le nom.
# Sans /v1 et sans barre finale : chaque client ajoute son chemin.
#   PROXY_URL=http://llmproxy
# Se change ICI, pas par `docker compose run -e PROXY_URL=…` : le
# docker-compose reprend cette valeur pour ANTHROPIC_BASE_URL (Claude Code)
# en lisant ce fichier.
PROXY_URL=http://127.0.0.1:8000

# Une clé de proxy.api_keys, ou n'importe quoi si le proxy est ouvert (un
# SDK en exige une). JAMAIS vide : Codex refuse de démarrer sur une variable
# de clé vide. C'est aussi la clé de l'extension web de pi (LLM_PROXY_KEY,
# posée par pi/entrypoint.sh, comme LLM_PROXY_URL depuis PROXY_URL).
PROXY_API_KEY=unused

# Les modèles PRÉFIXÉS sur lesquels les scénarios sont joués, séparés par
# des espaces : tout le jeu est rejoué pour chacun. Sans quota de
# préférence : chaque appel Claude Code coûte ~20 k tokens d'entrée (son
# prompt système). Les noms sont ceux du proxy VISÉ (GET /v1/models) : un
# proxy distant n'a pas forcément ceux-ci.
MODELS="bigchuck/qwen3.8-27b-mtp-nothink bigchuck/qwen3.6-35b-a3b-mtp-nothink"

# Claude Code : modèle des tâches d'arrière-plan (titres, résumés…).
SMALL_MODEL=bigchuck/qwen3.8-27b-mtp-nothink

# Rien à poser pour les scénarios de recherche web : chaque banc lit dans
# /healthz si le proxy visé héberge web_search (et web_fetch), et les SAUTE
# sinon (SKIP, compté à part dans le résumé).
