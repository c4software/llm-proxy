.env
__pycache__/
*.pyc
# Config réelle (elle porte les réglages du déploiement) et base de
# statistiques : le dépôt ne garde que data/config.example.toml.
data/config.toml
data/stats.db
data/stats.db-wal
data/stats.db-shm
# Secret des condensés de clés et mémoire persistante des clients.
data/client.secret
data/memory.db
data/memory.db-wal
data/memory.db-shm
# Comptes OIDC et condensés de leurs clés ; sauvegardes (backup.py) et ce
# qu'une restauration met de côté.
data/accounts.db
data/accounts.db-wal
data/accounts.db-shm
data/backups/
data/pre-restore-*/
.venv/
.pytest_cache/
bench/.env
# Le facultatif et le propre à la machine (voir
# docker-compose.override.example.yml).
docker-compose.override.yml
