# Les RÉGLAGES vivent dans data/config.toml (voir data/config.example.toml).
# Ce fichier ne porte plus que les SECRETS, injectés dans le TOML par
# «${VAR}», et l'emplacement de la configuration.
ALBERT_API_KEY=
# Clé exigée des clients du proxy ; référencée par proxy.api_keys.
PROXY_API_KEY=
# Clé secrète de l'instance SearXNG du compose (outil hébergé web_search).
# Facultative pour démarrer (vide, compose avertit et SearXNG tourne
# quand même), mais à poser. En générer une :
#   openssl rand -hex 32
SEARXNG_SECRET=
# Jeton partagé entre le proxy et l'exécuteur de code (outil hébergé
# code_execution) : exigé par l'exécuteur sur toute son API, référencé par
# [tools.code_execution].token. Vide, l'exécuteur démarre et refuse tout
# (et l'outil, désactivé par défaut, répond qu'il n'est pas configuré).
# En générer un :
#   openssl rand -hex 32
EXECUTOR_TOKEN=
# Le service `executor` vit dans docker-compose.override.example.yml, à
# copier en docker-compose.override.yml pour le mettre en route.
# Uid/gid propriétaires de ./data, pour que le conteneur puisse y écrire.
PUID=1000
PGID=1000
# CONFIG_PATH=/app/data/config.toml
