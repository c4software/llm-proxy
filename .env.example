# Les RÉGLAGES vivent dans data/config.toml (voir data/config.example.toml).
# Ce fichier ne porte plus que les SECRETS, injectés dans le TOML par
# «${VAR}», et l'emplacement de la configuration.
ALBERT_API_KEY=
# Clé exigée des clients du proxy ; référencée par proxy.api_keys.
PROXY_API_KEY=
# Uid/gid propriétaires de ./data, pour que le conteneur puisse y écrire.
PUID=1000
PGID=1000
# CONFIG_PATH=/app/data/config.toml
