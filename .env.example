# Les secrets seulement, injectés dans data/config.toml par «${VAR}» ;
# les réglages vivent dans le TOML (voir data/config.example.toml).
ALBERT_API_KEY=
# Clé exigée des clients du proxy ; référencée par proxy.api_keys.
PROXY_API_KEY=
# Client OIDC ([oidc].client_id et client_secret), si les comptes sont
# actifs : ce que le fournisseur a donné en déclarant l'application.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Clé secrète de SearXNG (outil web_search). Facultative pour démarrer,
# mais à poser :
#   openssl rand -hex 32
SEARXNG_SECRET=
# Jeton partagé proxy/exécuteur de code ([tools.code_execution].token).
# Vide, l'exécuteur refuse tout. Le service est dans
# docker-compose.override.example.yml. En générer un :
#   openssl rand -hex 32
EXECUTOR_TOKEN=
# Uid/gid propriétaires de ./data, pour que le conteneur puisse y écrire.
PUID=1000
PGID=1000
# CONFIG_PATH=/app/data/config.toml
