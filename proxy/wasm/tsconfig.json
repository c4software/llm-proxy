{
  // La VÉRIFICATION des types du code de la page (web/static), sans
  // build : les fichiers restent du JavaScript, annotés en JSDoc. Seuls
  // ceux qui commencent par `// @ts-check` sont vérifiés.
  //   npm run check
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["../llm_proxy/web/static/**/*.js", "types/*.d.ts"],
  "exclude": ["../llm_proxy/web/static/vendor/**", "../llm_proxy/web/static/vue.global.prod.js"]
}
