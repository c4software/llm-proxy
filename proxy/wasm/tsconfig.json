{
  // La VÉRIFICATION des types du code de la page (web/static, .js et le
  // <script> des .vue), par vue-tsc : du JavaScript annoté en JSDoc, tout
  // fichier vérifié d'office (`checkJs: true`).
  //   npm run check
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    // Une méthode réécrite d'un outil porte @override, qui doit nommer une
    // méthode de PageTool (tools/contract.js) : une faute de frappe est
    // une erreur.
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": [],
    // Les sources sont hors de ce dossier : leurs imports nus se résolvent
    // ici (comme l'alias de vite.config.mjs).
    "paths": {
      "vue": ["./node_modules/vue"],
      "@vueuse/core": ["./node_modules/@vueuse/core"]
    }
  },
  "include": ["../llm_proxy/ui/web/static/**/*.js", "../llm_proxy/ui/web/static/**/*.vue", "types/*.d.ts"],
  "exclude": ["../llm_proxy/ui/web/static/vendor/**"],
  // Le <script> des .vue est vérifié comme un .js ; leurs gabarits, eux,
  // sont compilés (et refusés s'ils sont faux) par le build, npm run check.
  "vueCompilerOptions": { "skipTemplateCodegen": true }
}
