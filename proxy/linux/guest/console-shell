#!/bin/bash
# ttyS0 : connexion automatique de root, bash de connexion dans /work —
# lancé par l'init de busybox, sans getty ni login (donc sans mot de passe).
export HOME=/root USER=root LOGNAME=root SHELL=/bin/bash TERM=${TERM:-xterm-256color}
stty -F /dev/ttyS0 sane 115200 2>/dev/null
cd /work
exec -a -bash /bin/bash
